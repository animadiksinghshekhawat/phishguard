{
  "manifest_version": 3,
  "name": "PhishGuard AI — Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time AI-based phishing URL and fraud website detector powered by 30-feature ML analysis.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PhishGuard AI — Check Current Tab"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://phishguard-ai-cxug.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
